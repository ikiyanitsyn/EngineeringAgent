{
 "name": "08-bar-convection",
 "units": "metric",
 "material": "steel_generic",
 "geometry": {
  "template": "beam",
  "params": {
   "length": 100,
   "width": 10,
   "height": 10
  }
 },
 "mesh": {
  "size": 2.5
 },
 "title": "Bar heated at one end, convection at the other",
 "analysis": "thermal_steady",
 "sets": {
  "hot": "xmin",
  "end": "xmax"
 },

#2116 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#2117 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(5.E-05),#2114,
  'distance_accuracy_value','confusion accuracy');
#2118 = PRODUCT_RELATED_PRODUCT_CATEGORY('part',$,(#7));
ENDSEC;
END-ISO-10303-21;
